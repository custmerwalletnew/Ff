def send_telegram(msg):
    try:
        requests.post(
            TELEGRAM_API,
            json={'chat_id': TELEGRAM_CHAT_ID, 'text': msg},
            timeout=5,
            verify=False
        )
    except:
        pass

def remove_from_file(phone):
    try:
        with open('lu1.txt', 'r', encoding='utf-8') as f:
            lines = f.readlines()
        with open('lu1.txt', 'w', encoding='utf-8') as f:
            f.writelines([l for l in lines if l.strip() != phone])
    except:
        pass

def main():
    try:
        with open('lu1.txt', 'r', encoding='utf-8') as f:
            phones = [line.strip() for line in f if line.strip()]
        
        total = len(phones)
        if total == 0:
            print("No phones found!")
            return
        
        print(f"\n{'='*60}")
        print(f"Total phones: {total}")
        print(f"Starting check via ScraperAPI...")
        print(f"{'='*60}\n")
        
        success = 0
        failed = 0
        
        for idx, phone in enumerate(phones, 1):
            result = check_phone(phone, idx, total)
            if result:
                success += 1
            else:
                failed += 1
            remove_from_file(phone)
        
        print(f"\n{'='*60}")
        print(f"Success: {success}")
        print(f"Failed: {failed}")
        print(f"{'='*60}\n")

    except FileNotFoundError:
        print("Error: lu1.txt not found!")
    except KeyboardInterrupt:
        print("\nStopped")

if __name__ == "__main__":
    main()
